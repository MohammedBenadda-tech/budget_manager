# ---------------------------------------------------------------------------
# Firebase - local tooling and SECRETS
# ---------------------------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
# Admin SDK / service account keys must NEVER be in this repository or in the
# app. They are server-side credentials.
service-account*.json
serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.p12
.env
.env.*
# NOTE: google-services.json and lib/firebase/firebase_options.dart are client
# configuration (not secrets) and are tracked by default - see
# docs/firebase_setup.md before changing that.

# ---------------------------------------------------------------------------
# Local databases created while running tests / the app on a dev machine
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
